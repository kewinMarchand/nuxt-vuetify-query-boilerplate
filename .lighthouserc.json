{
  "ci": {
    "collect": {
      "startServerCommand": "PORT=3210 yarn start",
      "startServerReadyPattern": "Listening",
      "url": [
        "http://localhost:3210/",
        "http://localhost:3210/taches",
        "http://localhost:3210/contact",
        "http://localhost:3210/catalogue",
        "http://localhost:3210/catalogue/plantes-interieur/feuillages",
        "http://localhost:3210/mentions-legales",
        "http://localhost:3210/donnees-personnelles",
        "http://localhost:3210/accessibilite",
        "http://localhost:3210/plan-du-site"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
