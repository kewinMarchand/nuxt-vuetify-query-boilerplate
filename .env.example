# URL publique du site (canonical, Open Graph, sitemap), lue à l'exécution
NUXT_PUBLIC_SITE_URL=http://localhost:3010

# Schéma OpenAPI de l'API consommée, pour `make api-types`
API_SCHEMA_URL=

# Suivi des erreurs GlitchTip (DSN au format Sentry), lu à l'exécution. Vides : aucun SDK chargé, aucune requête
NUXT_GLITCHTIP_DSN=
NUXT_PUBLIC_GLITCHTIP_DSN=
# Défaut : development en dev, production sinon
NUXT_PUBLIC_GLITCHTIP_ENVIRONMENT=

# Mesure d'audience Matomo sans cookie (URL de l'instance), lue à l'exécution. Vides : aucun script, aucune requête
NUXT_PUBLIC_MATOMO_URL=
NUXT_PUBLIC_MATOMO_SITE_ID=

# 1 pour servir la page de maintenance (503) sur toutes les routes
MAINTENANCE=
